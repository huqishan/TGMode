<UserControl x:Class="ControlLibrary.Controls.Loading.GlobalLoadingOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Panel.ZIndex="10000"
             Visibility="Collapsed">
    <!-- 全局遮罩由主窗口承载，业务界面通过 LoadingOverlayService 控制。 -->
    <Grid Background="#66000000">
        <Border Width="240"
                Padding="28,24"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="{DynamicResource PanelBrush}"
                BorderBrush="{DynamicResource AppCardBorderBrush}"
                BorderThickness="1"
                CornerRadius="14">
            <StackPanel HorizontalAlignment="Center">
                <Grid Width="44" Height="44" HorizontalAlignment="Center">
                    <Ellipse Stroke="{DynamicResource AppCardBorderBrush}" StrokeThickness="4" />
                    <Path Width="44"
                          Height="44"
                          Data="M 22,2 A 20,20 0 0 1 42,22"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"
                          Stroke="{DynamicResource PrimaryButtonBrush}"
                          StrokeEndLineCap="Round"
                          StrokeThickness="4">
                        <Path.RenderTransform>
                            <RotateTransform x:Name="SpinnerRotation" CenterX="22" CenterY="22" />
                        </Path.RenderTransform>
                        <Path.Triggers>
                            <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                <BeginStoryboard>
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation Storyboard.TargetName="SpinnerRotation"
                                                         Storyboard.TargetProperty="Angle"
                                                         From="0"
                                                         To="360"
                                                         Duration="0:0:0.8" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Path.Triggers>
                    </Path>
                </Grid>
                <TextBlock x:Name="MessageText"
                           Margin="0,16,0,0"
                           HorizontalAlignment="Center"
                           Foreground="{DynamicResource AppContentTextBrush}"
                           Text="正在加载，请稍候…"
                           TextAlignment="Center"
                           TextWrapping="Wrap" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
