<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- #region 首页配色资源 -->
    <SolidColorBrush x:Key="HomeOkBrush" Color="#52C6E8" />
    <SolidColorBrush x:Key="HomeGoodBrush" Color="#42C99A" />
    <SolidColorBrush x:Key="HomeNgBrush" Color="#E07870" />
    <SolidColorBrush x:Key="HomeNgBarBrush" Color="#E8AA55" />
    <SolidColorBrush x:Key="HomeGridLineBrush" Color="#263547" />
    <!-- #endregion -->

    <!-- #region 首页面板样式 -->
    <Style x:Key="HomePanelBorderStyle" TargetType="Border">
        <Setter Property="Padding" Value="16" />
        <Setter Property="Background" Value="{DynamicResource TabCardBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource TabItemBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="7" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <Style x:Key="HomePrimaryKpiBorderStyle"
           TargetType="Border"
           BasedOn="{StaticResource HomePanelBorderStyle}">
        <Setter Property="Background" Value="{DynamicResource PanelBrush}" />
    </Style>

    <Style x:Key="HomeKpiIconBorderStyle" TargetType="Border">
        <Setter Property="Width" Value="28" />
        <Setter Property="Height" Value="28" />
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Background" Value="{DynamicResource TabItemBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource TabItemBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="5" />
    </Style>

    <Style x:Key="HomeSectionTitleStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource AppContentTextBrush}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <Style x:Key="HomeMutedTextStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource AppMutedTextBrush}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <Style x:Key="HomeKpiValueStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource AppContentTextBrush}" />
        <Setter Property="FontSize" Value="27" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontFamily" Value="Segoe UI" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <!-- #endregion -->

    <!-- #region 首页设备状态样式 -->
    <Style x:Key="HomeOnlineSummaryDotStyle" TargetType="Ellipse">
        <Setter Property="Fill" Value="{StaticResource HomeGoodBrush}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding OnlineDeviceCount}" Value="0">
                <Setter Property="Fill" Value="{StaticResource HomeNgBarBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding IsBusy}" Value="True">
                <Setter Property="Fill" Value="{DynamicResource AppMutedTextBrush}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="HomeOfflineSummaryTextStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource HomeNgBarBrush}" />
        <Setter Property="FontSize" Value="11" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding OfflineDeviceCount}" Value="0">
                <Setter Property="Foreground" Value="{StaticResource HomeGoodBrush}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="HomeDeviceStatusDotStyle" TargetType="Ellipse">
        <Setter Property="Fill" Value="{DynamicResource AppMutedTextBrush}" />
        <Style.Triggers>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding IsInitialized}" Value="True" />
                    <Condition Binding="{Binding IsOnline}" Value="True" />
                </MultiDataTrigger.Conditions>
                <Setter Property="Fill" Value="{StaticResource HomeGoodBrush}" />
            </MultiDataTrigger>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding IsInitialized}" Value="True" />
                    <Condition Binding="{Binding IsOnline}" Value="False" />
                </MultiDataTrigger.Conditions>
                <Setter Property="Fill" Value="{StaticResource HomeNgBarBrush}" />
            </MultiDataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="HomeDeviceStatusTextStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource AppMutedTextBrush}" />
        <Setter Property="FontSize" Value="11" />
        <Style.Triggers>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding IsInitialized}" Value="True" />
                    <Condition Binding="{Binding IsOnline}" Value="True" />
                </MultiDataTrigger.Conditions>
                <Setter Property="Foreground" Value="{StaticResource HomeGoodBrush}" />
            </MultiDataTrigger>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding IsInitialized}" Value="True" />
                    <Condition Binding="{Binding IsOnline}" Value="False" />
                </MultiDataTrigger.Conditions>
                <Setter Property="Foreground" Value="{StaticResource HomeNgBarBrush}" />
            </MultiDataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="HomeDeviceDataValueTextStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource AppContentTextBrush}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsWithinRangeOrCondition}" Value="False">
                <Setter Property="Foreground" Value="{StaticResource HomeNgBrush}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="HomePopupCloseButtonStyle"
           TargetType="Button"
           BasedOn="{StaticResource ActionButtonStyle}">
        <Setter Property="Width" Value="28" />
        <Setter Property="Height" Value="28" />
        <Setter Property="MinWidth" Value="28" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{DynamicResource AppMutedTextBrush}" />
    </Style>
    <Style x:Key="HomeDeviceOnlineTriggerStyle" TargetType="Button">
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="True" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Chrome"
                            Padding="16"
                            Background="{DynamicResource PanelBrush}"
                            BorderBrush="{DynamicResource TabItemBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="7">
                        <ContentPresenter HorizontalAlignment="Stretch"
                                          VerticalAlignment="Stretch" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource TabItemHoverBrush}" />
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource TabItemHoverBorderBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Chrome" Property="Opacity" Value="0.82" />
                        </Trigger>
                        <DataTrigger Binding="{Binding IsDeviceStatusPopupOpen}" Value="True">
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource TabItemSelectedBorderBrush}" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="HomeDeviceEmptyStateStyle" TargetType="TextBlock">
        <Setter Property="Visibility" Value="Collapsed" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{DynamicResource AppMutedTextBrush}" />
        <Setter Property="FontSize" Value="12" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding TotalDeviceCount}" Value="0">
                <Setter Property="Visibility" Value="Visible" />
            </DataTrigger>
        </Style.Triggers>
    </Style>
    <!-- #endregion -->

    <!-- #region 首页时段切换样式 -->
    <Style x:Key="HomePeriodToggleStyle" TargetType="RadioButton">
        <Setter Property="MinWidth" Value="52" />
        <Setter Property="Height" Value="30" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="Foreground" Value="{DynamicResource AppMutedTextBrush}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="ToggleChrome"
                            Padding="{TemplateBinding Padding}"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            BorderThickness="1"
                            CornerRadius="4">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="ToggleChrome" Property="Background" Value="{DynamicResource TabItemSelectedBrush}" />
                            <Setter TargetName="ToggleChrome" Property="BorderBrush" Value="{DynamicResource TabItemSelectedBorderBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource TabItemSelectedForegroundBrush}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ToggleChrome" Property="Background" Value="{DynamicResource TabItemHoverBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="HomePeriodToggleGroupStyle" TargetType="Border">
        <Setter Property="Padding" Value="2" />
        <Setter Property="Background" Value="{DynamicResource TabStripBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource TabItemBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
    </Style>
    <!-- #endregion -->
</ResourceDictionary>
