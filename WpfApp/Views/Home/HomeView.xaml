<UserControl x:Class="WpfApp.Views.Home.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             HorizontalAlignment="Stretch"
             VerticalAlignment="Stretch"
             d:DesignHeight="900"
             d:DesignWidth="1500">
<Grid>
    <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Auto">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="16" />
                <RowDefinition Height="112" />
                <RowDefinition Height="14" />
                <RowDefinition Height="2*" MinHeight="370" />
            </Grid.RowDefinitions>

            <!-- #region 标题、数据状态和日期 -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Foreground="{DynamicResource AppMutedTextBrush}"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Text="PRODUCTION OVERVIEW" />
                    <TextBlock Margin="0,4,0,0"
                               Foreground="{DynamicResource AppContentTextBrush}"
                               FontSize="23"
                               FontWeight="Bold"
                               Text="生产总览" />
                </StackPanel>
                <StackPanel Grid.Column="1"
                            VerticalAlignment="Center"
                            Orientation="Horizontal">
                    <Border Margin="0,0,12,0"
                            Padding="12,7"
                            Background="#10231F"
                            BorderBrush="#274638"
                            BorderThickness="1"
                            CornerRadius="5">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="7"
                                     Height="7"
                                     Margin="0,0,8,0"
                                     VerticalAlignment="Center"
                                     Fill="{StaticResource HomeGoodBrush}" />
                            <TextBlock VerticalAlignment="Center"
                                       FontSize="12"
                                       Foreground="{StaticResource HomeGoodBrush}"
                                       Text="数据同步中" />
                        </StackPanel>
                    </Border>
                    <Border Padding="12,7"
                            Background="{DynamicResource TabCardBackgroundBrush}"
                            BorderBrush="{DynamicResource TabItemBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="5">
                        <StackPanel Orientation="Horizontal">
                            <Path Width="14"
                                  Height="14"
                                  Margin="0,0,8,0"
                                  VerticalAlignment="Center"
                                  Data="M5,2 L5,5 M11,2 L11,5 M2,6 L14,6 M3,3 L13,3 Q14,3 14,4 L14,13 Q14,14 13,14 L3,14 Q2,14 2,13 L2,4 Q2,3 3,3 Z"
                                  Stretch="Fill"
                                  Stroke="{DynamicResource AppMutedTextBrush}"
                                  StrokeThickness="1.2" />
                            <TextBlock VerticalAlignment="Center"
                                       Foreground="{DynamicResource AppContentTextBrush}"
                                       FontSize="12"
                                       Text="{Binding DateText}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
            <!-- #endregion -->

            <!-- #region 今日生产指标 -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.2*" />
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="1*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Margin="0,0,13,0"
                        Style="{StaticResource HomePrimaryKpiBorderStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="3" />
                        </Grid.RowDefinitions>
                        <Grid>
                            <TextBlock
                                       Style="{StaticResource HomeMutedTextStyle}"
                                       Text="今日总产量" />
                            <Border Style="{StaticResource HomeKpiIconBorderStyle}">
                                <Path Width="14"
                                      Height="14"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      Data="M2,13 L2,2 M2,13 L14,13 M4,10 L7,7 L10,9 L14,4 M11,4 L14,4 L14,7"
                                      Stroke="{StaticResource HomeOkBrush}"
                                      StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round"
                                      StrokeStartLineCap="Round"
                                      StrokeThickness="1.3" />
                            </Border>
                        </Grid>
                        <StackPanel Grid.Row="1" Orientation="Horizontal">
                            <TextBlock Style="{StaticResource HomeKpiValueStyle}"
                                       Text="{Binding ProductionTotal, StringFormat={}{0:N0}}" />
                            <TextBlock Margin="6,0,0,2"
                                       VerticalAlignment="Bottom"
                                       Style="{StaticResource HomeMutedTextStyle}"
                                       Text="件" />
                        </StackPanel>
                        <Grid Grid.Row="2" Margin="0,0,0,7">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Foreground="{StaticResource HomeGoodBrush}"
                                           FontSize="11"
                                           Text="{Binding ProductionChangeText}" />
                                <TextBlock Margin="6,0,0,0"
                                           Style="{StaticResource HomeMutedTextStyle}"
                                           Text="较昨日同期" />
                            </StackPanel>
                            <TextBlock Grid.Column="1"
                                       Style="{StaticResource HomeMutedTextStyle}"
                                       Text="{Binding TargetText}" />
                        </Grid>
                        <Grid Grid.Row="3" ClipToBounds="True">
                            <Border Background="#263746" CornerRadius="2" />
                            <Border Background="{StaticResource HomeOkBrush}"
                                    CornerRadius="2"
                                    RenderTransformOrigin="0,0.5">
                                <Border.RenderTransform>
                                    <ScaleTransform ScaleX="{Binding TargetCompletionRatio}" />
                                </Border.RenderTransform>
                            </Border>
                        </Grid>
                    </Grid>
                </Border>

                <Border Grid.Column="1"
                        Margin="0,0,13,0"
                        Style="{StaticResource HomePrimaryKpiBorderStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid>
                            <TextBlock Style="{StaticResource HomeMutedTextStyle}" Text="OK 数量" />
                            <Border Style="{StaticResource HomeKpiIconBorderStyle}">
                                <Path Width="14"
                                      Height="14"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      Data="M2,7 L6,11 L14,3"
                                      Stroke="{StaticResource HomeOkBrush}"
                                      StrokeEndLineCap="Round"
                                      StrokeStartLineCap="Round"
                                      StrokeThickness="1.5" />
                            </Border>
                        </Grid>
                        <StackPanel Grid.Row="1" Orientation="Horizontal">
                            <TextBlock Style="{StaticResource HomeKpiValueStyle}"
                                       Text="{Binding OkCount, StringFormat={}{0:N0}}" />
                            <TextBlock Margin="6,0,0,2"
                                       VerticalAlignment="Bottom"
                                       Style="{StaticResource HomeMutedTextStyle}"
                                       Text="件" />
                        </StackPanel>
                        <StackPanel Grid.Row="2" Orientation="Horizontal">
                            <TextBlock Style="{StaticResource HomeMutedTextStyle}" Text="占总产量" />
                            <TextBlock Margin="6,0,0,0"
                                       Foreground="{StaticResource HomeGoodBrush}"
                                       FontSize="11"
                                       Text="{Binding OkRateText}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Column="2"
                        Margin="0,0,13,0"
                        Style="{StaticResource HomePrimaryKpiBorderStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid>
                            <TextBlock Style="{StaticResource HomeMutedTextStyle}" Text="NG 数量" />
                            <Border Style="{StaticResource HomeKpiIconBorderStyle}">
                                <Path Width="14"
                                      Height="14"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      Data="M8,1 A7,7 0 1 1 7.99,1 M5.5,5.5 L10.5,10.5 M10.5,5.5 L5.5,10.5"
                                      Stroke="{DynamicResource AppMutedTextBrush}"
                                      StrokeEndLineCap="Round"
                                      StrokeStartLineCap="Round"
                                      StrokeThickness="1.2" />
                            </Border>
                        </Grid>
                        <StackPanel Grid.Row="1" Orientation="Horizontal">
                            <TextBlock Style="{StaticResource HomeKpiValueStyle}"
                                       Text="{Binding NgCount, StringFormat={}{0:N0}}" />
                            <TextBlock Margin="6,0,0,2"
                                       VerticalAlignment="Bottom"
                                       Style="{StaticResource HomeMutedTextStyle}"
                                       Text="件" />
                        </StackPanel>
                        <StackPanel Grid.Row="2" Orientation="Horizontal">
                            <TextBlock Style="{StaticResource HomeMutedTextStyle}" Text="NG 占比" />
                            <TextBlock Margin="6,0,0,0"
                                       Foreground="{StaticResource HomeNgBrush}"
                                       FontSize="11"
                                       Text="{Binding NgRateText}" />
                            <TextBlock Margin="7,0,0,0"
                                       Foreground="{StaticResource HomeGoodBrush}"
                                       FontSize="11"
                                       Text="·" />
                            <TextBlock Margin="5,0,0,0"
                                       Foreground="{StaticResource HomeGoodBrush}"
                                       FontSize="11"
                                       Text="{Binding NgChangeText}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Button x:Name="DeviceOnlineButton"
                        Grid.Column="3"
                        Command="{Binding ToggleDeviceStatusPopupCommand}"
                        Style="{StaticResource HomeDeviceOnlineTriggerStyle}"
                        AutomationProperties.Name="设备在线状态详情"
                        ToolTip="点击查看所有设备连接状态">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid>
                            <TextBlock Style="{StaticResource HomeMutedTextStyle}" Text="设备在线" />
                            <Border Style="{StaticResource HomeKpiIconBorderStyle}">
                                <Path Width="15"
                                      Height="14"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      Data="M1,2 L15,2 L15,11 L1,11 Z M5,14 L11,14 M8,11 L8,14 M4,5 L4.1,5 M8,5 L8.1,5 M12,5 L12.1,5"
                                      Stroke="{DynamicResource AppMutedTextBrush}"
                                      StrokeEndLineCap="Round"
                                      StrokeStartLineCap="Round"
                                      StrokeThickness="1.2" />
                            </Border>
                        </Grid>
                        <StackPanel Grid.Row="1" Orientation="Horizontal">
                            <TextBlock Style="{StaticResource HomeKpiValueStyle}"
                                       Text="{Binding OnlineDeviceCount}" />
                            <TextBlock Margin="6,0,0,2"
                                       VerticalAlignment="Bottom"
                                       Style="{StaticResource HomeMutedTextStyle}"
                                       Text="{Binding TotalDeviceCount, StringFormat='/ {0}'}"/>
                        </StackPanel>
                        <StackPanel Grid.Row="2" Orientation="Horizontal">
                                <TextBlock FontSize="11"
                                       Text="{Binding OfflineDeviceSummaryText}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{StaticResource HomeNgBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding OfflineDeviceSummaryText}" Value="全部正常">
                                                    <Setter Property="Foreground" Value="{StaticResource HomeGoodBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                        </StackPanel>
                    </Grid>
                </Button>
            </Grid>
            <!-- #endregion -->

            <!-- #region 时段产能图表与质量占比 -->
            <Grid Grid.Row="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.85*" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="1*" MinWidth="345" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource HomePanelBorderStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="32" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Style="{StaticResource HomeSectionTitleStyle}" Text="时段产能" />
                                <TextBlock Margin="0,4,0,0"
                                           Style="{StaticResource HomeMutedTextStyle}"
                                           Text="今日每小时产量与质量分布" />
                            </StackPanel>
                            <Border Grid.Column="1" Style="{StaticResource HomePeriodToggleGroupStyle}">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton Command="{Binding SelectPeriodCommand}"
                                                 CommandParameter="Hourly"
                                                 Content="小时"
                                                 GroupName="ProductionPeriod"
                                                 IsChecked="{Binding IsHourlySelected, Mode=OneWay}"
                                                 Style="{StaticResource HomePeriodToggleStyle}" />
                                    <RadioButton Command="{Binding SelectPeriodCommand}"
                                                 CommandParameter="Shift"
                                                 Content="班次"
                                                 GroupName="ProductionPeriod"
                                                 IsChecked="{Binding IsShiftSelected, Mode=OneWay}"
                                                 Style="{StaticResource HomePeriodToggleStyle}" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Grid Grid.Row="1" Margin="0,11,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="14" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="8" Height="8" Fill="{StaticResource HomeOkBrush}" />
                                <TextBlock Margin="6,0,0,0"
                                           VerticalAlignment="Center"
                                           Style="{StaticResource HomeMutedTextStyle}"
                                           Text="OK 产量" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Orientation="Horizontal">
                                <Ellipse Width="8" Height="8" Fill="{StaticResource HomeNgBarBrush}" />
                                <TextBlock Margin="6,0,0,0"
                                           VerticalAlignment="Center"
                                           Style="{StaticResource HomeMutedTextStyle}"
                                           Text="NG 产量" />
                            </StackPanel>
                            <TextBlock Grid.Column="3"
                                       HorizontalAlignment="Right"
                                       Style="{StaticResource HomeMutedTextStyle}"
                                       Text="{Binding ChartTargetText}" />
                        </Grid>

                        <Grid Grid.Row="2" Margin="0,8,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="22" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="42" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ItemsControl Grid.Column="0" ItemsSource="{Binding AxisLabels}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Rows="5" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Margin="0,-7,4,0"
                                                   HorizontalAlignment="Left"
                                                   VerticalAlignment="Top"
                                                   Style="{StaticResource HomeMutedTextStyle}"
                                                   Text="{Binding}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Grid x:Name="ProductionPlot" Grid.Column="1" Margin="0,0,0,21">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Border Grid.Row="0" VerticalAlignment="Top" BorderBrush="{StaticResource HomeGridLineBrush}" BorderThickness="0,1,0,0" />
                                <Border Grid.Row="1" VerticalAlignment="Top" BorderBrush="{StaticResource HomeGridLineBrush}" BorderThickness="0,1,0,0" />
                                <Border Grid.Row="2" VerticalAlignment="Top" BorderBrush="{StaticResource HomeGridLineBrush}" BorderThickness="0,1,0,0" />
                                <Border Grid.Row="3" VerticalAlignment="Top" BorderBrush="{StaticResource HomeGridLineBrush}" BorderThickness="0,1,0,0" />
                                <Border Grid.Row="4" VerticalAlignment="Bottom" BorderBrush="{StaticResource HomeGridLineBrush}" BorderThickness="0,1,0,0" />

                                <ItemsControl Grid.RowSpan="5" ItemsSource="{Binding ProductionItems}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Rows="1" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Height="240" VerticalAlignment="Bottom">
                                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Bottom">
                                                    <Border Width="26"
                                                            Height="{Binding NgHeight}"
                                                            Background="{StaticResource HomeNgBarBrush}"
                                                            CornerRadius="2,2,0,0" />
                                                    <Border Width="26"
                                                            Height="{Binding OkHeight}"
                                                            Background="{StaticResource HomeOkBrush}"
                                                            CornerRadius="0,0,2,2" />
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <Canvas Height="1"
                                        Grid.RowSpan="5"
                                        Margin="{Binding TargetLineMargin}"
                                        VerticalAlignment="Top"
                                        IsHitTestVisible="False">
                                    <Line X1="0"
                                          Y1="0"
                                          X2="{Binding ActualWidth, ElementName=ProductionPlot}"
                                          Y2="0"
                                          Stroke="#748395"
                                          StrokeDashArray="4,4"
                                          StrokeThickness="1"
                                          Opacity="0.65" />
                                </Canvas>
                            </Grid>

                            <ItemsControl Grid.Row="1"
                                          Grid.Column="1"
                                          Margin="0,2,0,0"
                                          ItemsSource="{Binding ProductionItems}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Rows="1" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock HorizontalAlignment="Center"
                                                   Style="{StaticResource HomeMutedTextStyle}"
                                                   Text="{Binding Label}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>

                        <Grid Grid.Row="3" Margin="0,7,0,0">
                            <TextBlock Style="{StaticResource HomeMutedTextStyle}"
                                       Text="{Binding PeakProductionText}" />
                            <TextBlock HorizontalAlignment="Right"
                                       Style="{StaticResource HomeMutedTextStyle}"
                                       Text="统计单位：件" />
                        </Grid>
                    </Grid>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource HomePanelBorderStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <StackPanel>
                            <TextBlock Style="{StaticResource HomeSectionTitleStyle}" Text="质量占比" />
                            <TextBlock Margin="0,4,0,0"
                                       Style="{StaticResource HomeMutedTextStyle}"
                                       Text="今日 OK / NG 数量分布" />
                        </StackPanel>

                        <Grid Grid.Row="1" Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1*" />
                                <ColumnDefinition Width="1*" />
                            </Grid.ColumnDefinitions>
                            <Grid Width="166" Height="166" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Ellipse Margin="7"
                                         Stroke="#26384A"
                                         StrokeThickness="15" />
                                <Ellipse Margin="7"
                                         Stroke="{StaticResource HomeGoodBrush}"
                                         StrokeThickness="15" />
                                <!--<Path Width="152"
                                      Height="152"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      Data="M76,7.5 A68.5,68.5 0 0 1 81.5,7.72"
                                      Stretch="Fill"
                                      Stroke="{StaticResource HomeNgBrush}"
                                      StrokeThickness="15" />-->
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock HorizontalAlignment="Center"
                                               Foreground="{DynamicResource AppContentTextBrush}"
                                               FontFamily="Segoe UI"
                                               FontSize="23"
                                               FontWeight="SemiBold"
                                               Text="{Binding OkRateText}" />
                                    <TextBlock Margin="0,4,0,0"
                                               HorizontalAlignment="Center"
                                               Style="{StaticResource HomeMutedTextStyle}"
                                               Text="一次合格率" />
                                </StackPanel>
                            </Grid>

                            <StackPanel Grid.Column="1"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center">
                                <Grid Margin="0,0,0,18">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="10" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="8" Height="28" Background="{StaticResource HomeOkBrush}" CornerRadius="3" />
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Style="{StaticResource HomeMutedTextStyle}" Text="OK 合格" />
                                        <StackPanel Margin="0,4,0,0" Orientation="Horizontal">
                                            <TextBlock Foreground="{DynamicResource AppContentTextBrush}"
                                                       FontSize="14"
                                                       FontWeight="SemiBold"
                                                       Text="{Binding OkCount, StringFormat={}{0:N0}}" />
                                            <TextBlock Margin="5,0,0,0"
                                                       VerticalAlignment="Bottom"
                                                       Style="{StaticResource HomeMutedTextStyle}"
                                                       Text="{Binding OkRateText}" />
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="10" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="8" Height="28" Background="{StaticResource HomeNgBrush}" CornerRadius="3" />
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Style="{StaticResource HomeMutedTextStyle}" Text="NG 不良" />
                                        <StackPanel Margin="0,4,0,0" Orientation="Horizontal">
                                            <TextBlock Foreground="{DynamicResource AppContentTextBrush}"
                                                       FontSize="14"
                                                       FontWeight="SemiBold"
                                                       Text="{Binding NgCount, StringFormat={}{0:N0}}" />
                                            <TextBlock Margin="5,0,0,0"
                                                       VerticalAlignment="Bottom"
                                                       Style="{StaticResource HomeMutedTextStyle}"
                                                       Text="{Binding NgRateText}" />
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Grid>

                        <Grid Grid.Row="2" Margin="0,6,0,0">
                            <Border Height="1" VerticalAlignment="Top" Background="{DynamicResource TabItemBorderBrush}" />
                            <TextBlock Margin="0,10,0,0"
                                       Style="{StaticResource HomeMutedTextStyle}"
                                       Text="总检测数" />
                            <TextBlock Margin="0,10,0,0"
                                       HorizontalAlignment="Right"
                                       Foreground="{DynamicResource AppContentTextBrush}"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Text="{Binding ProductionTotal, StringFormat={}{0:N0} 件}" />
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
            <!-- #endregion -->

        </Grid>
    </ScrollViewer>

    <!-- #region 设备连接状态抽屉 -->
    <Grid x:Name="DeviceStatusDrawerHost"
          Panel.ZIndex="10"
          Opacity="0"
          IsHitTestVisible="False">
        <Button Background="#3A000000"
                Command="{Binding CloseDeviceStatusPopupCommand}"
                Style="{StaticResource DrawerBackdropButtonStyle}"
                AutomationProperties.Name="关闭设备连接状态详情" />

        <Border Margin="0,150,0,0" Style="{StaticResource DrawerBorderStyle}">
            <Border.RenderTransform>
                <TranslateTransform x:Name="DeviceStatusDrawerTranslateTransform" Y="56" />
            </Border.RenderTransform>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="1" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Margin="0,0,0,12">
                        <StackPanel HorizontalAlignment="Right"
            VerticalAlignment="Center"
            Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" Fill="{StaticResource HomeGoodBrush}" Margin="0,2,0,0"/>
                            <TextBlock Margin="8,0,5,0" VerticalAlignment="Center"
               Foreground="{DynamicResource AppContentTextBrush}"
               FontSize="12"
               FontWeight="SemiBold"
               Text="{Binding OnlineDeviceCount}" />
                            <TextBlock Margin="4,0,0,0" VerticalAlignment="Center"
               Foreground="{DynamicResource AppMutedTextBrush}"
               FontSize="11"
               Text="{Binding TotalDeviceCount, StringFormat='/ {0} 在线'}"/>
                            <TextBlock Margin="14,0,14,0" VerticalAlignment="Center"
               FontSize="11"
               Text="{Binding OfflineDeviceSummaryText}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{StaticResource HomeNgBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding OfflineDeviceSummaryText}" Value="全部正常">
                                                <Setter Property="Foreground" Value="{StaticResource HomeGoodBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <Button Width="28"
        Height="28"
        HorizontalAlignment="Right"
        Command="{Binding CloseDeviceStatusPopupCommand}"
        Style="{StaticResource HomePopupCloseButtonStyle}"
        ToolTip="关闭">
                                <Path Width="12"
          Height="12"
          Data="M2,2 L10,10 M10,2 L2,10"
          Stroke="{DynamicResource AppMutedTextBrush}"
          StrokeEndLineCap="Round"
          StrokeStartLineCap="Round"
          StrokeThickness="1.4" />
                            </Button>
                        </StackPanel>
                        <DockPanel LastChildFill="False">
                            <Border Style="{StaticResource HomeKpiIconBorderStyle}">
                                <Path Width="15"
          Height="14"
          HorizontalAlignment="Center"
          VerticalAlignment="Center"
          Data="M1,2 L15,2 L15,11 L1,11 Z M5,14 L11,14 M8,11 L8,14 M4,5 L4.1,5 M8,5 L8.1,5 M12,5 L12.1,5"
          Stroke="{DynamicResource AppMutedTextBrush}"
          StrokeEndLineCap="Round"
          StrokeStartLineCap="Round"
          StrokeThickness="1.2" />
                            </Border>
                            <TextBlock VerticalAlignment="Center" Margin="5,0,0,0" Style="{StaticResource SectionTitleStyle}" Text="设备连接状态" />
                    </DockPanel>
                    </Grid>
                <ScrollViewer Grid.Row="2"
                              Margin="0,14,0,0"
                              HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Auto">
                    <Grid>
                        <TextBlock Style="{StaticResource HomeDeviceEmptyStateStyle}"
                                   Text="设备管理中暂无设备" />
                            <ItemsControl Grid.Row="2"
      HorizontalAlignment="Stretch"
      ItemsSource="{Binding Devices}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal"
                                                   HorizontalAlignment="Left" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,0,12,12"
                                                Padding="16,12"
                                                Width="350"
                                                MinHeight="136"
                                                Style="{StaticResource HomePanelBorderStyle}">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <Grid>
                                                    <TextBlock Margin="0,0,8,0"
                           VerticalAlignment="Center"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource AppContentTextBrush}"
                           Text="{Binding Name}"
                           TextTrimming="CharacterEllipsis" />
                                                    <StackPanel HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Orientation="Horizontal">
                                                        <Ellipse Width="6" Height="6">
                                                            <Ellipse.Style>
                                                                <Style TargetType="Ellipse">
                                                                    <Setter Property="Fill" Value="{StaticResource HomeGoodBrush}" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsOnline}" Value="False">
                                                                            <Setter Property="Fill" Value="{StaticResource HomeNgBrush}" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Ellipse.Style>
                                                        </Ellipse>
                                                        <TextBlock Margin="6,0,0,0" FontSize="11" Text="{Binding StatusText}">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Foreground" Value="{StaticResource HomeGoodBrush}" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsOnline}" Value="False">
                                                                            <Setter Property="Foreground" Value="{StaticResource HomeNgBrush}" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </StackPanel>
                                                </Grid>
                                                <TextBlock Grid.Row="1"
                       Margin="0,5,0,0"
                       Style="{StaticResource HomeMutedTextStyle}"
                       Text="{Binding Description}" />
                                                <Grid Grid.Row="2" Margin="0,5,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Style="{StaticResource HomeMutedTextStyle}"
                           Text="{Binding MetricLabel}" />
                                                    <TextBlock Grid.Column="1"
                           Foreground="{DynamicResource AppContentTextBrush}"
                           FontSize="11"
                           FontWeight="SemiBold"
                           Text="{Binding MetricValue}" />
                                                    <TextBlock Grid.Column="2"
                           HorizontalAlignment="Right"
                           Style="{StaticResource HomeMutedTextStyle}"
                           Text="{Binding UpdateText}" />
                                                </Grid>
                                                <Border Grid.Row="3" Margin="0,5,0,0" Height="1" Background="{DynamicResource TabItemBorderBrush}" />
                                                <ItemsControl Grid.Row="4"
                                                              Margin="0,5,0,0"
                                                              ItemsSource="{Binding DeviceData}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <WrapPanel Orientation="Horizontal"
                   HorizontalAlignment="Left" />
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <StackPanel Margin="0,0,10,0" Orientation="Horizontal">
                                                                <TextBlock Style="{StaticResource HomeMutedTextStyle}"
                                                                           Text="{Binding DataName, StringFormat={}{0}：}" />
                                                                <TextBlock Grid.Column="1"
                                                                           MaxWidth="175"
                                                                           HorizontalAlignment="Right"
                                                                           Style="{StaticResource HomeDeviceDataValueTextStyle}"
                                                                           Text="{Binding DataValue}"
                                                                           ToolTip="{Binding RangeOrCondition}" />
                                                            </StackPanel>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
    <!-- #endregion -->
</Grid>
</UserControl>
