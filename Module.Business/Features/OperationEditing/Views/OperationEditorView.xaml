<UserControl x:Class="Module.Business.Features.OperationEditing.Views.OperationEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:luaEditor="clr-namespace:ControlLibrary.ControlViews.LuaScrip;assembly=ControlLibrary"
             xmlns:converts="clr-namespace:ControlLibrary.Converts;assembly=ControlLibrary"
             xmlns:operationConverters="clr-namespace:Module.Business.Features.OperationEditing.Converters"
             xmlns:local="clr-namespace:Module.Business.Features.OperationEditing.Views"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             mc:Ignorable="d"
             d:DesignHeight="900"
             d:DesignWidth="1200">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="b2v" />
        <converts:ComparisonToVisibilityConvert x:Key="comp2v"/>
        <converts:InvertVisibilityConvert x:Key="in2v"/>
        <operationConverters:ParameterValueOptionsConverter x:Key="ParameterValueOptionsConverter" />
        <!-- 条件执行区需要在较小宽度内保持与步骤编辑器一致的输入控件外观，因此仅覆盖尺寸，不另造一套控件模板。 -->
        <Style x:Key="ConditionComboBoxStyle"
               TargetType="ComboBox"
               BasedOn="{StaticResource InputComboBoxStyle}">
            <Setter Property="Height" Value="30" />
            <Setter Property="MinWidth" Value="72" />
            <Setter Property="Padding" Value="8,3" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource InputComboBoxItemStyle}" />
        </Style>
        <!-- DataGridColumn 不继承数据上下文，使用 Freezable 代理避免 x:Reference 构造循环。 -->
        <local:BindingProxy x:Key="DataContextProxy" Data="{Binding}" />
    </UserControl.Resources>

    <Grid ClipToBounds="True">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="1.35*" />
        </Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal">
            <StackPanel>
                <TextBlock Style="{StaticResource FieldLabelStyle}"
  Text="{DynamicResource 描述}" />
                <TextBox Style="{StaticResource InputTextBoxStyle}"
AcceptsReturn="True"
TextWrapping="Wrap"
VerticalScrollBarVisibility="Auto" Width="200"
Text="{Binding EditingOperation.Summary, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>
            <StackPanel Margin="16,0,0,0">
                <TextBlock Style="{StaticResource FieldLabelStyle}"
  Text="{DynamicResource 延时(ms)}" />
                <TextBox Style="{StaticResource InputTextBoxStyle}" Width="118"
Text="{Binding EditingOperation.DelayMilliseconds, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>
        </StackPanel>
        <StackPanel Grid.Row="1" Margin="0,6,0,0" Orientation="Horizontal">
            <StackPanel x:Name="operationObj" Width="200">
                <TextBlock Style="{StaticResource FieldLabelStyle}"
 Text="{DynamicResource 操作对象}" />
                <ComboBox Style="{StaticResource InputComboBoxStyle}" x:Name="OperationObject"
ItemContainerStyle="{StaticResource InputComboBoxItemStyle}" Height="38"
ItemsSource="{Binding OperationObjectOptions}" SelectedItem="{Binding EditingOperation.OperationObjectName}"/>
                <StackPanel Visibility="{Binding ElementName=luaEdit, Path=Visibility, Converter={StaticResource in2v}}">
                    <TextBlock Style="{StaticResource FieldLabelStyle}" Text="支持的方法/指令" />
                </StackPanel>
            </StackPanel>
            <StackPanel Margin="16,0,0,0">
                <TextBlock Style="{StaticResource FieldLabelStyle}" x:Name="returnValue"
  Text="返回值" />
                <TextBox Style="{StaticResource InputTextBoxStyle}" Width="118"
Text="{Binding EditingOperation.ReturnValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>
        </StackPanel>

        <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,5,0,0" Visibility="{Binding EditingOperation.OperationObjectName, Converter={StaticResource comp2v}, ConverterParameter='Lua'}">
            <TextBlock Style="{StaticResource FieldLabelStyle}" Text="Lua脚本模版" />
            <ComboBox x:Name="LuaScriptTemplateComboBox" Height="38"
Style="{StaticResource EditableInputComboBoxStyle}"
ItemContainerStyle="{StaticResource InputComboBoxItemStyle}"
ItemsSource="{Binding LuaScriptTemplateOptions}"
SelectionChanged="LuaScriptTemplateComboBox_SelectionChanged" />
        </StackPanel>

        <Grid Grid.Row="2">
            <DataGrid x:Name="OperationMethodDataGrid" Visibility="{Binding ElementName=luaEdit, Path=Visibility, Converter={StaticResource in2v}}"
HorizontalScrollBarVisibility="Disabled"
AutoGenerateColumns="False"
IsReadOnly="True"
ItemsSource="{Binding StationOperationMethodCollection}"
SelectionChanged="OperationMethodDataGrid_SelectionChanged"
MouseDoubleClick="OperationMethodDataGrid_MouseDoubleClick"
Style="{StaticResource ColumnsDataGridStyle}">
                <DataGrid.Columns>
                    <DataGridTextColumn Width="1.2*"
                  Header="{DynamicResource 方法/指令}"
                  ElementStyle="{StaticResource CellTextBlockStyle}"
                  Binding="{Binding InvokeMethod}" />
                    <DataGridTextColumn Width="1.5*"
                  Header="{DynamicResource 说明}"
                  ElementStyle="{StaticResource CellTextBlockStyle}"
                  Binding="{Binding Summary}" />
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
        <!--Lua-->
        <Grid Grid.Row="2" Grid.ColumnSpan="3" x:Name="luaEdit" VerticalAlignment="Stretch" Visibility="{Binding EditingOperation.OperationObjectName, Converter={StaticResource comp2v}, ConverterParameter='Lua'}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="1.35*" />
            </Grid.ColumnDefinitions>
            <Grid Grid.Row="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Style="{StaticResource FieldLabelStyle}"
Text="{DynamicResource 输入参数}" />
                <DockPanel HorizontalAlignment="Right" Margin="0,0,-10,0">
                    <Button
Command="{Binding AddParametersCommand}" Height="30" Width="30"
Content="+" Padding="0"
Style="{StaticResource ActionButtonStyle}"
ToolTip="添加输入参数" />
                    <Button
Command="{Binding DeleteParametersCommand}" Height="30" Width="30"
Content="-"  Padding="0"
Style="{StaticResource ActionButtonStyle}"
ToolTip="删除输入参数" />
                </DockPanel>
                
                <DataGrid Grid.Row="1" AutoGenerateColumns="False"
HorizontalScrollBarVisibility="Disabled"
IsReadOnly="False"
ItemsSource="{Binding EditingParameterRows}"
SelectedValuePath="Parameter"
SelectedValue="{Binding SelectedEditingInvokeParameter, Mode=TwoWay}"
Style="{StaticResource ColumnsDataGridStyle}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Width="Auto"
                  Header="{DynamicResource 参数名称}"
                  ElementStyle="{StaticResource CellTextBlockStyle}"
                  EditingElementStyle="{StaticResource CellTextBoxStyle}"
                  Binding="{Binding Parameter.ParameterName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <DataGridTemplateColumn Width="1*"
                      Header="{DynamicResource 参数类型}">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <ComboBox Style="{StaticResource InputComboBoxStyle}"
                    ItemContainerStyle="{StaticResource InputComboBoxItemStyle}"
                    ItemsSource="{Binding DataContext.ParameterTypeOptions, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                    SelectedItem="{Binding Parameter.ParameterType, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Width="1.35*"
                      Header="{DynamicResource 参数值}">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <TextBox Style="{StaticResource CellTextBoxStyle}" ToolTip="{Binding Parameter.Value}"
                       Visibility="{Binding Parameter.ParameterType, Converter={StaticResource comp2v}, ConverterParameter=设置值}"
                       Text="{Binding Parameter.Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                        <ComboBox ItemContainerStyle="{StaticResource InputComboBoxItemStyle}" ToolTip="{Binding Parameter.Value}"
                        Style="{StaticResource EditableInputComboBoxStyle}" Padding="0" Height="34"
                        DropDownOpened="ParameterValueComboBox_DropDownOpened"
                        Visibility="{Binding Parameter.ParameterType, Converter={StaticResource comp2v}, ConverterParameter=返回值|业务值|全局值}"
                        Text="{Binding Parameter.Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                            <ComboBox.ItemsSource>
                                                <MultiBinding Converter="{StaticResource ParameterValueOptionsConverter}">
                                                    <Binding Path="Parameter.ParameterType" />
                                                    <Binding Path="DataContext.ParameterReturnValueOptions" RelativeSource="{RelativeSource AncestorType={x:Type UserControl}}" />
                                                    <Binding Path="DataContext.WorkStepValueOptions" RelativeSource="{RelativeSource AncestorType={x:Type UserControl}}" />
                                                </MultiBinding>
                                            </ComboBox.ItemsSource>
                                        </ComboBox>
                                    </Grid>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
            <luaEditor:LuaScriptCompilerView x:Name="luaEditView" BeforeExecute="LuaEditView_BeforeExecute" Margin="0,14,0,0" Grid.Column="2" ScriptText="{Binding EditingOperation.LuaScript, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
        </Grid>
        <!--其它操作对象-->
        <ScrollViewer Grid.Column="2" Grid.RowSpan="3"  Visibility="{Binding ElementName=luaEdit, Path=Visibility, Converter={StaticResource in2v}}"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">

            <Grid Margin="0,0,4,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition/>
                    <RowDefinition/>
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0">
                    <!-- #region 条件执行界面：直接绑定步骤内的条件执行实体，随步骤保存和克隆。 -->
                    <Border Background="{DynamicResource TabCardBackgroundBrush}"
                            BorderBrush="{DynamicResource TabItemBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="4">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- 标题栏沿用卡片体系的次级背景色，通过复选框控制下方编辑区是否可操作。 -->
                            <Border Padding="10,7"
                                    Background="{DynamicResource TabItemBackgroundBrush}"
                                    CornerRadius="4,4,0,0">
                                <CheckBox x:Name="ConditionExecutionCheckBox"
                                          VerticalAlignment="Center"
                                          IsChecked="{Binding EditingOperation.ConditionExecution.IsEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          Content="条件执行" />
                            </Border>

                            <Grid Grid.Row="1"
                                  Margin="10,8,10,10"
                                  IsEnabled="{Binding IsChecked, ElementName=ConditionExecutionCheckBox}">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Margin="0,0,5,6" VerticalAlignment="Center" Text="左参数  类型:" />
                                <ComboBox Grid.Column="1"
                                          Margin="0,0,8,6"
                                          ItemsSource="{Binding ParameterTypeOptions}"
                                          SelectedItem="{Binding EditingOperation.ConditionExecution.LeftParameterType, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          Style="{StaticResource ConditionComboBoxStyle}" />
                                <TextBlock Grid.Column="2" Margin="0,0,5,6" VerticalAlignment="Center" Text="值:" />
                                <ComboBox Grid.Column="3" Grid.ColumnSpan="2" Margin="0,0,0,6"
                                          IsEditable="True"
                                          DropDownOpened="ParameterValueComboBox_DropDownOpened"
                                          Text="{Binding EditingOperation.ConditionExecution.LeftValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          Style="{StaticResource ConditionComboBoxStyle}">
                                    <ComboBox.ItemsSource>
                                        <MultiBinding Converter="{StaticResource ParameterValueOptionsConverter}">
                                            <Binding Path="EditingOperation.ConditionExecution.LeftParameterType" />
                                            <Binding Path="ParameterReturnValueOptions" />
                                            <Binding Path="WorkStepValueOptions" />
                                        </MultiBinding>
                                    </ComboBox.ItemsSource>
                                </ComboBox>

                                <TextBlock Grid.Row="1" Margin="0,0,5,6" VerticalAlignment="Center" Text="关系符  条件:" />
                                <ComboBox Grid.Row="1"
                                          Grid.Column="1"
                                          Margin="0,0,8,6"
                                          ItemsSource="{Binding JudgmentConditionOptions}"
                                          SelectedItem="{Binding EditingOperation.ConditionExecution.RelationOperator, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          Style="{StaticResource ConditionComboBoxStyle}" />
                                <!--<CheckBox Grid.Row="1"
                                          Grid.Column="2"
                                          Grid.ColumnSpan="3"
                                          Margin="0,0,0,6"
                                          VerticalAlignment="Center"
                                          Content="字符串参数" />-->

                                <TextBlock Grid.Row="2" Margin="0,0,5,6" VerticalAlignment="Center" Text="右参数  类型:" />
                                <ComboBox Grid.Row="2"
                                          Grid.Column="1"
                                          Margin="0,0,8,6"
                                          ItemsSource="{Binding ParameterTypeOptions}"
                                          SelectedItem="{Binding EditingOperation.ConditionExecution.RightParameterType, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          Style="{StaticResource ConditionComboBoxStyle}" />
                                <TextBlock Grid.Row="2" Grid.Column="2" Margin="0,0,5,6" VerticalAlignment="Center" Text="值:" />
                                <ComboBox Grid.Row="2" Grid.Column="3" Grid.ColumnSpan="2" Margin="0,0,0,6"
                                          IsEditable="True"
                                          DropDownOpened="ParameterValueComboBox_DropDownOpened"
                                          Text="{Binding EditingOperation.ConditionExecution.RightValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          Style="{StaticResource ConditionComboBoxStyle}">
                                    <ComboBox.ItemsSource>
                                        <MultiBinding Converter="{StaticResource ParameterValueOptionsConverter}">
                                            <Binding Path="EditingOperation.ConditionExecution.RightParameterType" />
                                            <Binding Path="ParameterReturnValueOptions" />
                                            <Binding Path="WorkStepValueOptions" />
                                        </MultiBinding>
                                    </ComboBox.ItemsSource>
                                </ComboBox>
                                <StackPanel Grid.Row="3" Grid.ColumnSpan="2" Orientation="Horizontal">
                                    <CheckBox VerticalAlignment="Center"
                                              IsChecked="{Binding EditingOperation.ConditionExecution.IsNgJumpEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              Content="判断NG跳转到步骤ID：" />
                                    <TextBox Margin="0,0,5,0" Padding="8,6" Height="30"
                                             IsEnabled="{Binding EditingOperation.ConditionExecution.IsNgJumpEnabled}"
                                             Text="{Binding EditingOperation.ConditionExecution.NgJumpStepId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource InputTextBoxStyle}" Width="85"/>
                                </StackPanel>


                                <TextBlock Grid.Row="3"
                                           Grid.Column="2"
                                           Grid.ColumnSpan="3"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource AppMutedTextBrush}"
                                           Text="区间：~，例如 1~100" />
                            </Grid>
                        </Grid>
                    </Border>
                    <!-- #endregion -->
                </StackPanel>
                <Grid Margin="0,6,0,0" Grid.Row="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Style="{StaticResource FieldLabelStyle}"
           Text="{DynamicResource 输入参数}" />
                    <DataGrid x:Name="InvokeParameterDataGrid" Grid.Row="1"
          AutoGenerateColumns="False"
          CellEditEnding="InvokeParameterDataGrid_CellEditEnding"
          HorizontalScrollBarVisibility="Disabled"
          IsReadOnly="False"
          ItemsSource="{Binding EditingParameterRows}"
          SelectedValuePath="Parameter"
          SelectedValue="{Binding SelectedEditingInvokeParameter, Mode=TwoWay}"
          Style="{StaticResource ColumnsDataGridStyle}">
                        <DataGrid.Columns>
                            <!--<DataGridTextColumn Width="54" IsReadOnly="True"
                            Header="{DynamicResource 序号}"
                            ElementStyle="{StaticResource CellTextBlockStyle}"
                            EditingElementStyle="{StaticResource CellTextBoxStyle}"
                            Binding="{Binding Parameter.Num, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />-->
                            <DataGridTemplateColumn Width="1*"
                                Header="{DynamicResource 参数类型}">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ComboBox Style="{StaticResource EditableInputComboBoxStyle}"
                              ItemContainerStyle="{StaticResource InputComboBoxItemStyle}"
                              ItemsSource="{Binding DataContext.ParameterTypeOptions, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                              SelectedItem="{Binding Parameter.ParameterType, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Width="1.35*"
                                Header="{DynamicResource 参数值}">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <TextBox Style="{StaticResource CellTextBoxStyle}" ToolTip="{Binding Parameter.Value}"
                                 Visibility="{Binding Parameter.ParameterType, Converter={StaticResource comp2v}, ConverterParameter=设置值}"
                                 Text="{Binding Parameter.Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                            <ComboBox ItemContainerStyle="{StaticResource InputComboBoxItemStyle}" ToolTip="{Binding Parameter.Value}"
                                  Style="{StaticResource EditableInputComboBoxStyle}" Padding="0" Height="34"
                                  DropDownOpened="ParameterValueComboBox_DropDownOpened"
                                  Visibility="{Binding Parameter.ParameterType, Converter={StaticResource comp2v}, ConverterParameter=返回值|业务值|全局值}"
                                  Text="{Binding Parameter.Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                                <ComboBox.ItemsSource>
                                                    <MultiBinding Converter="{StaticResource ParameterValueOptionsConverter}">
                                                        <Binding Path="Parameter.ParameterType" />
                                                        <Binding Path="DataContext.ParameterReturnValueOptions" RelativeSource="{RelativeSource AncestorType={x:Type UserControl}}" />
                                                        <Binding Path="DataContext.WorkStepValueOptions" RelativeSource="{RelativeSource AncestorType={x:Type UserControl}}" />
                                                    </MultiBinding>
                                                </ComboBox.ItemsSource>
                                            </ComboBox>
                                        </Grid>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Width="1.25*" IsReadOnly="True"
                            Header="{DynamicResource 描述}"
                            EditingElementStyle="{StaticResource CellTextBoxStyle}"
                            Binding="{Binding Parameter.Description, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource CellTextBlockStyle}">
                                        <!-- 描述列宽度有限，悬停时通过 ToolTip 展示完整参数说明。 -->
                                        <Setter Property="ToolTip" Value="{Binding Parameter.Description}" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
                <Grid Margin="0,6,0,0" Grid.Row="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Style="{StaticResource FieldLabelStyle}"
                               Text="{DynamicResource 返回参数}" />
                    <TextBlock Margin="0,6,0,8" Grid.Row="1"
                               Foreground="{DynamicResource AppMutedTextBrush}"
                               Text="返回参数列表中的所有项都会作为当前步骤可输出的返回值。"
                               TextWrapping="Wrap" />

                    <DataGrid x:Name="ReturnParameterDataGrid" Grid.Row="2"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              HorizontalScrollBarVisibility="Disabled"
                              IsReadOnly="False"
                              ItemsSource="{Binding EditingOperation.ReturnValues}"
                              Style="{StaticResource ColumnsDataGridStyle}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Width="*"
                                                Header="返回值键"
                                                IsReadOnly="True"
                                                ElementStyle="{StaticResource CellTextBlockStyle}"
                                                EditingElementStyle="{StaticResource CellTextBoxStyle}"
                                                Binding="{Binding ReturnParameterName, Mode=OneWay}" />
                            <DataGridCheckBoxColumn Width="Auto"
                                                    Header="显示"
                                                    Binding="{Binding IsShowView, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <!--<DataGridTemplateColumn Header="显示名称"
                                                    Visibility="{Binding Data.HasVisibleReturnValueName, Source={StaticResource DataContextProxy}, Converter={StaticResource b2v}}">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        --><!-- DataGridColumn 不继承行数据上下文，可见性必须绑定在单元格内容上。 --><!--
                                        <TextBox HorizontalAlignment="Left" Width="250" Visibility="{Binding IsShowView, Converter={StaticResource b2v}}"
                                                 Style="{StaticResource CellTextBoxStyle}"
                                                 Text="{Binding ViewDataName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>-->
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
