<UserControl x:Class="Module.Business.Features.Station.Views.StationConfigurationView"
             x:Name="StationConfigurationRoot"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:businessViews="clr-namespace:Module.Business.Features.OperationEditing.Views"
             xmlns:converts="clr-namespace:ControlLibrary.Converts;assembly=ControlLibrary"
             xmlns:operationConverters="clr-namespace:Module.Business.Features.OperationEditing.Converters"
             xmlns:flowchartViews="clr-namespace:ControlLibrary.ControlViews.Flowchart;assembly=ControlLibrary"
             xmlns:searchBox="clr-namespace:ControlLibrary.Controls.SearchBox.Control;assembly=ControlLibrary"
             mc:Ignorable="d"
             HorizontalAlignment="Stretch"
             VerticalAlignment="Stretch"
             d:DesignHeight="760"
             d:DesignWidth="1600">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="b2v" />
        <converts:InvertVisibilityConvert x:Key="in2v" />
        <operationConverters:ParameterValueOptionsConverter x:Key="ParameterValueOptionsConverter" />
    </UserControl.Resources>

    <Grid HorizontalAlignment="Stretch"
          VerticalAlignment="Stretch">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="400" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel>
                    <DockPanel LastChildFill="False">
                        <TextBlock Style="{StaticResource SectionTitleStyle}"
                                   Text="工位配置" />
                        <Border DockPanel.Dock="Right"
                                Margin="16,0,0,0"
                                Padding="10,5"
                                Background="{DynamicResource TabCardBackgroundBrush}"
                                BorderBrush="{DynamicResource TabItemBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="999">
                            <TextBlock FontWeight="SemiBold"
                                       Foreground="{DynamicResource AppMutedTextBrush}"
                                       Text="{Binding StationCountText}" />
                        </Border>
                    </DockPanel>
                    <TextBlock Margin="0,8,0,0"
                               Foreground="{DynamicResource AppMutedTextBrush}"
                               Text="管理多个工位，并在右侧维护工位自身的流程图。"
                               TextWrapping="Wrap" />
                </StackPanel>

                <searchBox:SearchBox Grid.Row="1"
                                     Margin="0,16,0,0"
                                     PlaceholderText="搜索工位..."
                                     Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                <UniformGrid Grid.Row="2" Columns="4" Margin="0,16,0,16">
                    <Button Content="新建"
                            Command="{Binding NewStationCommand}"
                            Style="{StaticResource PrimaryActionButtonStyle}" />
                    <Button Content="复制"
                            Command="{Binding DuplicateStationCommand}"
                            Style="{StaticResource ActionButtonStyle}" />
                    <Button Content="删除"
                            Command="{Binding DeleteStationCommand}"
                            Style="{StaticResource ActionButtonStyle}" />
                    <Button Content="保存"
                            Command="{Binding SaveStationCommand}"
                            Style="{StaticResource ActionButtonStyle}" />
                </UniformGrid>

                <ListBox Grid.Row="3"
                         BorderThickness="0"
                         Background="Transparent"
                         ItemContainerStyle="{StaticResource ListBoxItemStyle}"
                         ItemsSource="{Binding StationsView}"
                         SelectedItem="{Binding SelectedStation, Mode=TwoWay}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <DockPanel LastChildFill="False">
                                    <TextBlock FontSize="15"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource AppContentTextBrush}"
                                               Text="{Binding StationName}" />
                                    <Border DockPanel.Dock="Right"
                                            Margin="10,0,0,0"
                                            MinWidth="78"
                                            Padding="8,2"
                                            Background="{DynamicResource PrimaryButtonBrush}"
                                            BorderBrush="{DynamicResource TabItemBorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="999">
                                        <TextBlock FontSize="11"
                                                   FontWeight="SemiBold"
                                                   HorizontalAlignment="Center"
                                                   Foreground="{DynamicResource SecondaryButtonForegroundBrush}"
                                                   Text="{Binding StationCode}" />
                                    </Border>
                                </DockPanel>
                                <TextBlock Margin="0,8,0,0"
                                           Foreground="{DynamicResource AppMutedTextBrush}"
                                           Text="{Binding Summary}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <Grid Grid.Column="2"
              HorizontalAlignment="Stretch"
              VerticalAlignment="Stretch">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="16" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Style="{StaticResource CardBorderStyle}">
                <StackPanel>
                    <DockPanel LastChildFill="False">
                        <TextBlock Style="{StaticResource SectionTitleStyle}"
                                   Text="当前工位" />
                        <Border DockPanel.Dock="Right"
                                Margin="16,0,0,0"
                                Padding="12,6"
                                VerticalAlignment="Top"
                                Background="{DynamicResource TabCardBackgroundBrush}"
                                BorderBrush="{DynamicResource TabItemBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="999">
                            <TextBlock FontWeight="SemiBold"
                                       Foreground="{Binding PageStatusBrush}"
                                       Text="{Binding PageStatusText}" />
                        </Border>
                    </DockPanel>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel IsEnabled="{Binding HasSelectedStation}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Style="{StaticResource FieldLabelStyle}"
                                               Text="工位名称" />
                                    <TextBox Style="{StaticResource InputTextBoxStyle}"
                                             Text="{Binding SelectedStation.StationName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Style="{StaticResource FieldLabelStyle}"
                                               Text="工位编码" />
                                    <TextBox Style="{StaticResource InputTextBoxStyle}"
                                             Text="{Binding SelectedStation.StationCode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <CheckBox Grid.Column="4" VerticalAlignment="Bottom" Margin="0,0,0,10"
          Content="是否启用"
          IsChecked="{Binding SelectedStation.IsEnabled, Mode=TwoWay}" />
                            </Grid>

                            
                        </StackPanel>

                    </Grid>
                </StackPanel>
            </Border>

            <Border Grid.Row="2" Style="{StaticResource CardBorderStyle}">
                <flowchartViews:FlowchartNodePanelView x:Name="FlowchartPanel"
                                                       Document="{Binding SelectedStation.FlowchartDocument, Mode=TwoWay}"
                                                       NodeDoubleClick="Editor_NodeDoubleClick" />
            </Border>
        </Grid>

        <Grid x:Name="NodeOperationEditorHost"
              Grid.ColumnSpan="3"
              Panel.ZIndex="60"
              Visibility="{Binding IsNodeOperationEditorOpen, Converter={StaticResource b2v}}">
            <Border Background="#59000000"
                    MouseLeftButtonDown="NodeOperationEditorBackdrop_MouseLeftButtonDown" />

            <Border Padding="24"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Style="{StaticResource CardBorderStyle}">
                <Grid DataContext="{Binding NodeOperationEditor}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <DockPanel LastChildFill="False">
                        <StackPanel DockPanel.Dock="Left">
                            <TextBlock Style="{StaticResource SectionTitleStyle}"
                                       Text="{Binding DataContext.NodeOperationEditorTitle, ElementName=StationConfigurationRoot}" />
                        </StackPanel>
                    </DockPanel>

                    <!-- 处理块继续使用完整步骤编辑器。 -->
                    <businessViews:OperationEditorView Grid.Row="1"
                                                       Width="800"
                                                       Height="800"
                                                       Visibility="{Binding Visibility, ElementName=DecisionNodeEditor, Converter={StaticResource in2v}}" />

                    <!-- #region 判断块编辑界面：复用步骤实体中的描述与条件执行配置，不提供 NG 隐式跳转。 -->
                    <StackPanel x:Name="DecisionNodeEditor"
                                Grid.Row="1"
                                Width="500"
                                Visibility="{Binding DataContext.IsEditingDecisionNode, ElementName=StationConfigurationRoot, Converter={StaticResource b2v}}">
                        <StackPanel Orientation="Horizontal">
                            <StackPanel>
                                <TextBlock Style="{StaticResource FieldLabelStyle}"
  Text="{DynamicResource 描述}" />
                                <TextBox Style="{StaticResource InputTextBoxStyle}"
AcceptsReturn="True"
TextWrapping="Wrap"
VerticalScrollBarVisibility="Auto" Width="365"
Text="{Binding EditingOperation.Summary, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Margin="16,0,0,0">
                                <TextBlock Style="{StaticResource FieldLabelStyle}"
  Text="{DynamicResource 延时(ms)}" />
                                <TextBox Style="{StaticResource InputTextBoxStyle}" Width="118"
Text="{Binding EditingOperation.DelayMilliseconds, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </StackPanel>
                        <Border Margin="0,18,0,0"
            Background="{DynamicResource TabCardBackgroundBrush}"
            BorderBrush="{DynamicResource TabItemBorderBrush}"
            BorderThickness="1"
            CornerRadius="4">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Border Padding="12,9"
                    Background="{DynamicResource TabItemBackgroundBrush}"
                    CornerRadius="4,4,0,0">
                                    <TextBlock FontWeight="SemiBold" Text="判断条件" />
                                </Border>
                                <Grid Grid.Row="1" Margin="12,12,12,14">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="180" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Margin="0,0,8,10" VerticalAlignment="Center" Text="左参数类型：" />
                                    <ComboBox Grid.Column="1" Margin="0,0,16,10" Height="35"
                          ItemsSource="{Binding ParameterTypeOptions}"
                          ItemContainerStyle="{StaticResource InputComboBoxItemStyle}"
                          SelectedItem="{Binding EditingOperation.ConditionExecution.LeftParameterType, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                          Style="{StaticResource InputComboBoxStyle}" />
                                    <TextBlock Grid.Column="2" Margin="0,0,8,10" VerticalAlignment="Center" Text="值：" />
                                    <ComboBox Grid.Column="3" Margin="0,0,0,10" Height="35" IsEditable="True"
                          ItemContainerStyle="{StaticResource InputComboBoxItemStyle}"
                          Text="{Binding EditingOperation.ConditionExecution.LeftValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                          Style="{StaticResource InputComboBoxStyle}">
                                        <ComboBox.ItemsSource>
                                            <MultiBinding Converter="{StaticResource ParameterValueOptionsConverter}">
                                                <Binding Path="EditingOperation.ConditionExecution.LeftParameterType" />
                                                <Binding Path="ParameterReturnValueOptions" />
                                                <Binding Path="WorkStepValueOptions" />
                                            </MultiBinding>
                                        </ComboBox.ItemsSource>
                                    </ComboBox>

                                    <TextBlock Grid.Row="1" Margin="0,0,8,10" VerticalAlignment="Center" Text="关系符：" />
                                    <ComboBox Grid.Row="1" Grid.Column="1" Margin="0,0,16,10" Height="35"
                          ItemsSource="{Binding JudgmentConditionOptions}"
                          ItemContainerStyle="{StaticResource InputComboBoxItemStyle}"
                          SelectedItem="{Binding EditingOperation.ConditionExecution.RelationOperator, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                          Style="{StaticResource InputComboBoxStyle}" />

                                    <TextBlock Grid.Row="2" Margin="0,0,8,0" VerticalAlignment="Center" Text="右参数类型：" />
                                    <ComboBox Grid.Row="2" Grid.Column="1" Margin="0,0,16,0" Height="35"
                          ItemsSource="{Binding ParameterTypeOptions}"
                          ItemContainerStyle="{StaticResource InputComboBoxItemStyle}"
                          SelectedItem="{Binding EditingOperation.ConditionExecution.RightParameterType, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                          Style="{StaticResource InputComboBoxStyle}" />
                                    <TextBlock Grid.Row="2" Grid.Column="2" Margin="0,0,8,0" VerticalAlignment="Center" Text="值：" />
                                    <ComboBox Grid.Row="2" Grid.Column="3" Height="35" IsEditable="True"
                          ItemContainerStyle="{StaticResource InputComboBoxItemStyle}"
                          Text="{Binding EditingOperation.ConditionExecution.RightValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                          Style="{StaticResource InputComboBoxStyle}">
                                        <ComboBox.ItemsSource>
                                            <MultiBinding Converter="{StaticResource ParameterValueOptionsConverter}">
                                                <Binding Path="EditingOperation.ConditionExecution.RightParameterType" />
                                                <Binding Path="ParameterReturnValueOptions" />
                                                <Binding Path="WorkStepValueOptions" />
                                            </MultiBinding>
                                        </ComboBox.ItemsSource>
                                    </ComboBox>
                                </Grid>
                            </Grid>
                        </Border>

                        <TextBlock Margin="0,10,0,0"
               HorizontalAlignment="Right"
               Foreground="{DynamicResource AppMutedTextBrush}"
               Text="判断成立走“是”出口，不成立走“否”出口；区间使用 ~，例如 1~100。" />
                    </StackPanel>
                    <!-- #endregion -->

                    <StackPanel Grid.Row="2"
                                Margin="0,18,0,0"
                                HorizontalAlignment="Right"
                                Orientation="Horizontal">
                        <Button Content="取消"
                                Click="NodeOperationEditorCancelButton_Click"
                                Style="{StaticResource ActionButtonStyle}" />
                        <Button Content="保存"
                                Click="NodeOperationEditorSaveButton_Click"
                                Style="{StaticResource PrimaryActionButtonStyle}" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
