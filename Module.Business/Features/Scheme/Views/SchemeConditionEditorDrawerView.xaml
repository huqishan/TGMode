<UserControl x:Class="Module.Business.Features.Scheme.Views.SchemeConditionEditorDrawerView"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid x:Name="DrawerHost" Visibility="Collapsed" IsHitTestVisible="False">
        <Border x:Name="DrawerBackdrop"
                Background="#3A000000"
                Opacity="0"
                MouseLeftButtonDown="DrawerBackdrop_MouseLeftButtonDown" />

        <!-- 判断条件采用宽抽屉连续显示全部业务，结构与 TestDataTable 的合并业务列保持一致。 -->
        <Border x:Name="DrawerSheet"
                Width="1280"
                MaxWidth="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                HorizontalAlignment="Right"
                Style="{StaticResource DrawerBorderStyle}">
            <Border.RenderTransform>
                <TranslateTransform x:Name="DrawerTranslateTransform" X="56" />
            </Border.RenderTransform>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- 标题与统一保存操作。 -->
                <DockPanel LastChildFill="True">
                    <StackPanel DockPanel.Dock="Right" Margin="16,0,0,0" Orientation="Horizontal">
                        <Button Content="取消"
                                Command="{Binding Editor.CloseCommand, ElementName=Root}"
                                Style="{StaticResource ActionButtonStyle}" />
                        <Button Content="保存"
                                Command="{Binding Editor.SaveCommand, ElementName=Root}"
                                Style="{StaticResource PrimaryActionButtonStyle}" />
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitleStyle}"
                                   Text="{Binding Editor.Title, ElementName=Root}" />
                        <TextBlock Margin="0,8,0,0"
                                   Foreground="{DynamicResource AppMutedTextBrush}"
                                   Text="集中维护方案内全部业务参数与返回判断条件"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </DockPanel>

                <!-- 搜索、类型筛选和数据统计。 -->
                <Grid Grid.Row="1" Margin="0,16,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="260" />
                        <ColumnDefinition Width="220" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBox Margin="0,0,12,0"
                             Style="{StaticResource InputTextBoxStyle}"
                             Text="{Binding Editor.SearchText, ElementName=Root, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="搜索业务或参数" />
                    <ComboBox Grid.Column="1"
                              Margin="0,0,12,0"
                              ItemContainerStyle="{StaticResource InputComboBoxItemStyle}"
                              ItemsSource="{Binding Editor.ParameterFilters, ElementName=Root}"
                              SelectedItem="{Binding Editor.SelectedParameterFilter, ElementName=Root, Mode=TwoWay}"
                              Style="{StaticResource InputComboBoxStyle}" />
                    <TextBlock Grid.Column="2"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource AppMutedTextBrush}">
                        <Run Text="{Binding Editor.WorkStepCount, ElementName=Root, Mode=OneWay}" />
                        <Run Text=" 个业务 · 输入 " />
                        <Run Text="{Binding Editor.InputParameterCount, ElementName=Root, Mode=OneWay}" />
                        <Run Text=" · 返回 " />
                        <Run Text="{Binding Editor.ReturnParameterCount, ElementName=Root, Mode=OneWay}" />
                    </TextBlock>
                </Grid>

                <!-- 固定表头；列宽与下方业务分组完全一致。 -->
                <Grid Grid.Row="2" Height="36" Background="{DynamicResource TabItemSelectedBrush}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="170" />
                        <ColumnDefinition Width="130" />
                        <ColumnDefinition Width="220" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="160" />
                        <ColumnDefinition Width="90" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Style="{StaticResource CellTextBlockStyle}" Text="业务" TextAlignment="Center" />
                    <TextBlock Grid.Column="1" Style="{StaticResource CellTextBlockStyle}" Text="参数类型" TextAlignment="Center"/>
                    <TextBlock Grid.Column="2" Style="{StaticResource CellTextBlockStyle}" Text="参数名称" TextAlignment="Center" />
                    <TextBlock Grid.Column="3" Style="{StaticResource CellTextBlockStyle}" Text="参数值 / 显示名称" TextAlignment="Center" />
                    <TextBlock Grid.Column="4" Style="{StaticResource CellTextBlockStyle}" Text="判断符号" TextAlignment="Center" />
                    <TextBlock Grid.Column="5" Style="{StaticResource CellTextBlockStyle}" Text="判断值" TextAlignment="Center" />
                    <TextBlock Grid.Column="6" Style="{StaticResource CellTextBlockStyle}" Text="单位" TextAlignment="Center" />
                </Grid>

                <!-- 业务分组左侧单元格纵向合并，右侧参数行连续排列。 -->
                <Border Grid.Row="3"
                        BorderBrush="{DynamicResource TabItemBorderBrush}"
                        BorderThickness="1,0,1,1"
                        ClipToBounds="True">
                    <ListBox Background="Transparent"
                             BorderThickness="0"
                             ItemsSource="{Binding Editor.Groups, ElementName=Root}"
                             ScrollViewer.CanContentScroll="True"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.VirtualizationMode="Recycling">
                        <!-- 分组行需要铺满表格且不显示选中态，使用轻量容器以启用回收虚拟化。 -->
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="IsTabStop" Value="False" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <ContentPresenter />
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VirtualizingStackPanel />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="170" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Background="#0D1689D8"
                                                BorderBrush="{DynamicResource TabItemBorderBrush}"
                                                BorderThickness="0,0,1,1">
                                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <TextBlock FontWeight="SemiBold" Text="{Binding WorkStepName}" TextAlignment="Center" />
                                                <TextBlock Margin="0,5,0,0"
                                                           Foreground="{DynamicResource AppMutedTextBrush}"
                                                           Text="{Binding ParameterSummary}"
                                                           TextAlignment="Center" />
                                            </StackPanel>
                                        </Border>

                                        <ItemsControl Grid.Column="1" ItemsSource="{Binding Items}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border MinHeight="44"
                                                            BorderBrush="{DynamicResource TabItemBorderBrush}"
                                                            BorderThickness="0,0,0,1">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Background" Value="{DynamicResource TabCardBackgroundBrush}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsReturnParameter}" Value="True">
                                                                        <Setter Property="Background" Value="#0F36A875" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="130" />
                                                                <ColumnDefinition Width="220" />
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="120" />
                                                                <ColumnDefinition Width="160" />
                                                                <ColumnDefinition Width="90" />
                                                            </Grid.ColumnDefinitions>

                                                            <Border Grid.Column="0" Margin="12,7" Padding="8,3" CornerRadius="4" HorizontalAlignment="Center">
                                                                <Border.Style>
                                                                    <Style TargetType="Border">
                                                                        <Setter Property="Background" Value="#121689D8" />
                                                                        <Setter Property="BorderBrush" Value="#501689D8" />
                                                                        <Setter Property="BorderThickness" Value="1" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsReturnParameter}" Value="True">
                                                                                <Setter Property="Background" Value="#1236A875" />
                                                                                <Setter Property="BorderBrush" Value="#5036A875" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Border.Style>
                                                                <TextBlock Text="{Binding ParameterType}" VerticalAlignment="Center"/>
                                                            </Border>
                                                            <TextBlock Grid.Column="1" Margin="12,0" VerticalAlignment="Center" Text="{Binding ParameterName}" TextTrimming="CharacterEllipsis" />
                                                            <TextBox Grid.Column="2" Margin="8,5"
                                                             Style="{StaticResource InputTextBoxStyle}"
                                                                     Text="{Binding EditableValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                            <ComboBox Grid.Column="3" Margin="8,5"
                                                                      ItemContainerStyle="{StaticResource InputComboBoxItemStyle}"
                                                                      ItemsSource="{Binding Editor.JudgeOperators, ElementName=Root}"
                                                                      SelectedItem="{Binding Operator, Mode=TwoWay}">
                                                                <ComboBox.Style>
                                                                    <Style TargetType="ComboBox" BasedOn="{StaticResource InputComboBoxStyle}">
                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsReturnParameter}" Value="True">
                                                                                <Setter Property="Visibility" Value="Visible" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </ComboBox.Style>
                                                            </ComboBox>
                                                            <TextBlock Grid.Column="3" HorizontalAlignment="Center" VerticalAlignment="Center" Text="-">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Visibility" Value="Visible" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsReturnParameter}" Value="True">
                                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                            <TextBox Grid.Column="4" Margin="8,5"
                                                                     Text="{Binding JudgeValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                                                <TextBox.Style>
                                                                    <Style TargetType="TextBox" BasedOn="{StaticResource InputTextBoxStyle}">
                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsReturnParameter}" Value="True">
                                                                                <Setter Property="Visibility" Value="Visible" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBox.Style>
                                                            </TextBox>
                                                            <TextBlock Grid.Column="4" HorizontalAlignment="Center" VerticalAlignment="Center" Text="-">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Visibility" Value="Visible" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsReturnParameter}" Value="True">
                                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                            <TextBox Grid.Column="5"
                                                                     Margin="8,5"
                                                                     Text="{Binding Unit, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                                                <TextBox.Style>
                                                                    <Style TargetType="TextBox" BasedOn="{StaticResource InputTextBoxStyle}">
                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsReturnParameter}" Value="True">
                                                                                <Setter Property="Visibility" Value="Visible" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBox.Style>
                                                            </TextBox>
                                                            <TextBlock Grid.Column="5"
                                                                       HorizontalAlignment="Center"
                                                                       VerticalAlignment="Center"
                                                                       Text="-">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Visibility" Value="Visible" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsReturnParameter}" Value="True">
                                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                    </ListBox>
                </Border>

                <!-- 保存提示和参数类型图例。 -->
                <DockPanel Grid.Row="4" Margin="0,12,0,0">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <TextBlock Margin="0,0,18,0" Foreground="#1689D8" Text="● 输入参数" />
                        <TextBlock Foreground="#36A875" Text="● 返回参数" />
                    </StackPanel>
                    <TextBlock Foreground="{DynamicResource AppMutedTextBrush}" Text="修改仅在点击保存后写入方案" />
                </DockPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
