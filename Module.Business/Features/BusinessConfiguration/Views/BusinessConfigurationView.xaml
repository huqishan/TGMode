<UserControl x:Class="Module.Business.Features.WorkStep.Views.WorkStepConfigurationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:searchBox="clr-namespace:ControlLibrary.Controls.SearchBox.Control;assembly=ControlLibrary"
             xmlns:operationEditingViews="clr-namespace:Module.Business.Features.OperationEditing.Views"
             mc:Ignorable="d"
             HorizontalAlignment="Stretch"
             VerticalAlignment="Stretch"
             d:DesignHeight="760"
             d:DesignWidth="1800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="400" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- 左侧沿用方案配置的卡片、搜索和列表排版，仅展示业务自身信息。 -->
        <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitleStyle}" Text="业务配置" />
                    <TextBlock Margin="0,8,0,0"
                               Foreground="{DynamicResource AppMutedTextBrush}"
                               Text="维护可被方案复用的业务及操作步骤。"
                               TextWrapping="Wrap" />
                </StackPanel>

                <searchBox:SearchBox Grid.Row="1"
                                     Margin="0,16,0,0"
                                     PlaceholderText="搜索业务配置..."
                                     Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                <UniformGrid Grid.Row="2" Columns="4" Margin="0,16,0,16">
                    <Button Content="{DynamicResource 新建}" Command="{Binding NewWorkStepCommand}"
                            Style="{StaticResource PrimaryActionButtonStyle}" />
                    <Button Content="{DynamicResource 复制}" Command="{Binding DuplicateWorkStepCommand}"
                            Style="{StaticResource ActionButtonStyle}" />
                    <Button Content="{DynamicResource 删除}" Command="{Binding DeleteWorkStepCommand}"
                            Style="{StaticResource ActionButtonStyle}" />
                    <Button Content="{DynamicResource 保存}" Click="SaveWorkStepsButton_Click"
                            Style="{StaticResource ActionButtonStyle}" />
                </UniformGrid>

                <ListBox x:Name="WorkStepsListBox"
                         Grid.Row="3"
                         BorderThickness="0"
                         Background="Transparent"
                         ItemContainerStyle="{StaticResource ListBoxItemStyle}"
                         ItemsSource="{Binding WorkStepsView}"
                         SelectedItem="{Binding SelectedWorkStep, Mode=TwoWay}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <TextBox FontSize="15"
                                         FontWeight="SemiBold"
                                         Style="{StaticResource SchemeNameTextBoxStyle}"
                                         Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Margin="0,8,0,0"
                                           Foreground="{DynamicResource AppMutedTextBrush}"
                                           Text="{Binding LastModifiedText}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <!-- 右侧步骤列表与当前方案配置中的步骤列表保持相同字段、按钮和交互。 -->
        <Border Grid.Column="2" Padding="16" Style="{StaticResource CardBorderStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Border DockPanel.Dock="Right"
        HorizontalAlignment="Right"
        Padding="12,6"
        Background="{DynamicResource TabCardBackgroundBrush}"
        BorderBrush="{DynamicResource TabItemBorderBrush}"
        BorderThickness="1"
        CornerRadius="999">
                    <TextBlock FontWeight="SemiBold"
               Foreground="{Binding PageStatusBrush}"
               Text="{Binding PageStatusText}" />
                </Border>
                <TextBlock Style="{StaticResource SectionTitleStyle}" Text="步骤列表" />
                <DockPanel Grid.Row="1" Margin="0,8,0,10">
                    <StackPanel>
                        <TextBlock FontSize="15" FontWeight="SemiBold"
                                   Foreground="{DynamicResource AppContentTextBrush}"
                                   Text="{Binding SelectedWorkStep.Name, TargetNullValue=未选择业务}" />
                        <TextBlock Margin="0,6,0,0"
                                   Foreground="{DynamicResource AppMutedTextBrush}"
                                   Text="双击步骤可打开完整编辑，拖拽可调整顺序。" />
                    </StackPanel>
                    <DockPanel LastChildFill="False">
                        
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Content="{DynamicResource 新建步骤}" Command="{Binding AddStepCommand}"
                Style="{StaticResource PrimaryActionButtonStyle}" />
                            <Button Margin="12,0,0,0" Content="{DynamicResource 复制步骤}"
                Command="{Binding CopyStepCommand}" Style="{StaticResource ActionButtonStyle}" />
                            <Button Margin="12,0,0,0" Content="{DynamicResource 粘贴步骤}"
                Command="{Binding PasteStepCommand}" Style="{StaticResource ActionButtonStyle}" />
                            <Button Margin="12,0,0,0" Content="{DynamicResource 删除步骤}"
                Command="{Binding DeleteStepCommand}" Style="{StaticResource ActionButtonStyle}" />
                        </StackPanel>
                    </DockPanel>
                </DockPanel>

                <Grid Grid.Row="2">
                    <DataGrid x:Name="OperationsDataGrid"
                              HorizontalScrollBarVisibility="Disabled"
                              ItemsSource="{Binding StepCollection}"
                              SelectedItem="{Binding SelectedOperation, Mode=TwoWay}"
                              AllowDrop="True"
                              PreviewMouseLeftButtonDown="OperationsDataGrid_PreviewMouseLeftButtonDown"
                              PreviewMouseMove="OperationsDataGrid_PreviewMouseMove"
                              DragOver="OperationsDataGrid_DragOver"
                              DragLeave="OperationsDataGrid_DragLeave"
                              Drop="OperationsDataGrid_Drop"
                              CellEditEnding="OperationsDataGrid_CellEditEnding"
                              MouseDoubleClick="OperationsDataGrid_MouseDoubleClick"
                              Style="{StaticResource ColumnsDataGridStyle}">
                        <DataGrid.RowStyle>
                            <Style TargetType="{x:Type DataGridRow}" BasedOn="{StaticResource DataGridRowStyle}">
                                <Setter Property="ToolTip" Value="{Binding Summary}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Summary}" Value="">
                                        <Setter Property="ToolTip" Value="{x:Null}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="{DynamicResource 选择}">
                                <DataGridTemplateColumn.HeaderTemplate>
                                    <DataTemplate>
                                        <CheckBox HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  IsChecked="{Binding DataContext.AreAllStepsChecked, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.HeaderTemplate>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  IsChecked="{Binding IsChecked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Width="64" Header="{DynamicResource 序号}" SortMemberPath="Num"
                                                ElementStyle="{StaticResource CellTextBlockStyle}"
                                                EditingElementStyle="{StaticResource CellTextBoxStyle}"
                                                Binding="{Binding Num, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <DataGridTextColumn Width="180" Header="{DynamicResource 操作对象}" IsReadOnly="True"
                                                ElementStyle="{StaticResource CellTextBlockStyle}" Binding="{Binding OperationObjectName}" />
                            <DataGridTextColumn Width="180" Header="{DynamicResource 调用方法}" IsReadOnly="True"
                                                ElementStyle="{StaticResource CellTextBlockStyle}" Binding="{Binding PCommandName}" />
                            <DataGridTextColumn Width="96" Header="{DynamicResource 延时(ms)}"
                                                ElementStyle="{StaticResource CellTextBlockStyle}"
                                                EditingElementStyle="{StaticResource CellTextBoxStyle}"
                                                Binding="{Binding DelayMilliseconds, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <DataGridTextColumn Width="140" Header="返回值"
                                                ElementStyle="{StaticResource CellTextBlockStyle}"
                                                EditingElementStyle="{StaticResource CellTextBoxStyle}"
                                                Binding="{Binding ReturnValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <DataGridTextColumn Width="*" Header="描述" IsReadOnly="True"
                                                ElementStyle="{StaticResource CellTextBlockStyle}"
                                                EditingElementStyle="{StaticResource CellTextBoxStyle}"
                                                Binding="{Binding Summary, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </DataGrid.Columns>
                    </DataGrid>
                    
                    <!--步骤拖拽排序时的插入位置提示线-->
                    <Canvas x:Name="OperationDropIndicatorCanvas" IsHitTestVisible="False">
                        <Border x:Name="OperationDropIndicator" Height="3" CornerRadius="2"
                                Visibility="Collapsed" Background="{DynamicResource PrimaryButtonBrush}" />
                    </Canvas>
                    <!-- 复用公共步骤编辑抽屉，仅覆盖步骤列表区域，并从该区域右侧滑入。 -->
                    <operationEditingViews:OperationEditorDrawerView
                                                 Panel.ZIndex="30"
                                                 IsRightAligned="True"
                                                 IsOpen="{Binding OperationEditor.IsOpen}"
                                                 Title="{Binding OperationEditor.Title}"
                                                 BtnTitle="{Binding OperationEditor.BtnTitle}"
                                                 HostStepName="{Binding SelectedWorkStep.Name}"
                                                 Editor="{Binding OperationEditor}"
                                                 SaveCommand="{Binding OperationEditor.SaveCommand}"
                                                 CloseCommand="{Binding OperationEditor.CloseCommand}" />
                </Grid>
            </Grid>
        </Border>

        
    </Grid>
</UserControl>
